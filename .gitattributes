# ──────────────────────────────────────────────────────────────────────────────
# Microsoft Office / 文書格式
# （*.dot 為 Word 範本，與上方範本引擎副檔名分開處理）
# ──────────────────────────────────────────────────────────────────────────────
*.doc   diff=astextplain
*.DOC   diff=astextplain
*.docx  diff=astextplain
*.DOCX  diff=astextplain
*.dot   diff=astextplain
*.DOT   diff=astextplain
*.rtf   diff=astextplain
*.RTF   diff=astextplain

# ──────────────────────────────────────────────────────────────────────────────
# 原始碼
# ──────────────────────────────────────────────────────────────────────────────

# Web / CSS
*.css   text diff=css
*.scss  text diff=css
*.sass  text
*.less  text
*.styl  text

# Web / HTML & 樣板
*.htm    text diff=html
*.html   text diff=html
*.xhtml  text diff=html
*.cshtml text diff=html

# JavaScript / TypeScript
*.js    text
*.mjs   text
*.cjs   text
*.jsx   text
*.ts    text
*.tsx   text
*.coffee text

# PHP
*.php  text
*.inc  text

# Python
*.py   text

# Ruby
*.rb   text

# Shell
*.sh   text eol=lf

# Perl
*.pl   text

# PowerShell（在 Windows 上慣用 CRLF）
*.ps1  text eol=crlf

# Batch（必須 CRLF）
*.bat  text eol=crlf

# Go（-text 跳過斷行轉換；Go 工具鏈自行處理）
*.go   -text diff=golang

# C / C++
*.c     text diff=cpp
*.cc    text diff=cpp
*.cxx   text diff=cpp
*.cpp   text diff=cpp
*.cpi   text diff=cpp
*.c++   text diff=cpp
*.h     text diff=cpp
*.hh    text diff=cpp
*.hpp   text diff=cpp
*.h++   text diff=cpp

# C#
*.cs      text diff=csharp
*.csx     text diff=csharp

# Java / JVM 生態
*.java        text diff=java
*.kt          text diff=kotlin
*.groovy      text diff=java
*.scala       text diff=java
*.gradle      text diff=java
*.gradle.kts  text diff=kotlin
*.jsp         text
*.jspf        text
*.jspx        text
*.tld         text
*.tag         text
*.tagx        text
*.properties  text

# SQL
*.sql  text

# XML / 通用標記
*.xml  text
*.xsl  text
*.xsd  text

# JSON / YAML / TOML
*.json  text
*.yaml  text
*.yml   text
*.toml  text

# 鎖定檔（關閉 diff；大量自動產生的異動沒有閱讀價值）
package-lock.json  text -diff
yarn.lock          text -diff
pnpm-lock.yaml     text -diff
Gemfile.lock       text -diff

# 環境變數
*.env  text

# GraphQL
*.graphql  text
*.gql      text

# Prisma
