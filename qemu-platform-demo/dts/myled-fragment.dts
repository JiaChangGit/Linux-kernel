/*
 * myled-fragment.dts
 *
 * Fragment to be merged into the QEMU ARM64 virt machine DTB.
 * The node registers a virtual LED controller at MMIO 0x0d000000.
 *
 * Properties demonstrated:
 *   - compatible  : triggers OF match in the driver
 *   - reg         : MMIO base + size (parsed by platform_get_resource)
 *   - num-leds    : custom u32 property (of_property_read_u32)
 *   - label       : custom string property (of_property_read_string)
 *   - default-brightness : optional init value
 *   - status      : "okay" to activate the node
 */

/dts-v1/;

/* This fragment is merged with the QEMU-generated DTB via fdtoverlay */
/plugin/;

/ {
    fragment@0 {
        target-path = "/";

        __overlay__ {

            /*
            * myled platform device
            * mapped to MMIO region 0x0d000000
            * size: 0x1000 (4KB register space)
            */
            myled: myled-controller@0d000000 {

                /* Driver binding key (must match of_match_table) */
                compatible = "myvendor,myled-v1";

                /*
                * Physical MMIO region
                * [base address, size]
                */
                reg = <0x0 0x0d000000 0x0 0x1000>;

                /* Number of LEDs controlled by this device */
                num-leds = <4>;

                /* Human readable label */
                label = "demo-rgb-led";

                /* Default brightness at boot */
                default-brightness = <180>;

                /* Enable device */
                status = "okay";
            };
        };
    };
};
